rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['teamId', 'teamName', 'score', 'status'])
        && data.teamId is string && data.teamId.size() <= 64
        && data.teamName is string && data.teamName.size() <= 100
        && data.score is number && data.score >= 0
        && data.status in ['idle', 'lobby', 'countdown', 'active', 'completed', 'failed', 'WAITING'];
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'senderRole', 'senderName', 'text', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.senderRole in ['OPERATIVE_A', 'OPERATIVE_B']
        && data.senderName is string && data.senderName.size() <= 64
        && data.text is string && data.text.size() <= 1000
        && data.timestamp is number;
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isValidId(teamId) && isValidTeam(incoming());
      allow update: if isValidId(teamId);
      allow delete: if true;

      // Team Messages Subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if true;
      }
    }

    // Event Configuration Collection (Authoritative 105m timer & event parameters)
    match /eventConfig/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }
  }
}
